{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-ai-os/agent",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "capability",
    "version",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0
    },
    "max_runtime_seconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
